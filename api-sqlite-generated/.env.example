# Copy to .env; loaded at startup, existing variables are not overridden.
API_SQLITE_GENERATED_ADDR=127.0.0.1:8080
API_SQLITE_GENERATED_LOG=info,tower_http=debug
API_SQLITE_GENERATED_LOG_FORMAT=pretty
API_SQLITE_GENERATED_RATE_LIMIT_RPS=10
API_SQLITE_GENERATED_RATE_LIMIT_BURST=50
API_SQLITE_GENERATED_TRUST_PROXY=false
DATABASE_URL=sqlite://api-sqlite-generated.db?mode=rwc
API_SQLITE_GENERATED_RUN_MIGRATIONS=true
API_SQLITE_GENERATED_CACHE_TTL=60
API_SQLITE_GENERATED_CACHE_CAPACITY=10000
