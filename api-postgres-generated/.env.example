# Copy to .env; loaded at startup, existing variables are not overridden.
API_POSTGRES_GENERATED_ADDR=127.0.0.1:8080
API_POSTGRES_GENERATED_LOG=info,tower_http=debug
API_POSTGRES_GENERATED_LOG_FORMAT=pretty
API_POSTGRES_GENERATED_RATE_LIMIT_RPS=10
API_POSTGRES_GENERATED_RATE_LIMIT_BURST=50
API_POSTGRES_GENERATED_TRUST_PROXY=false
DATABASE_URL=postgres://postgres:postgres@localhost:5432/api_postgres_generated
API_POSTGRES_GENERATED_RUN_MIGRATIONS=true
