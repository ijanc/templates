# Copy to .env; loaded at startup, existing variables are not overridden.
GRAPHQL_POSTGRES_GENERATED_ADDR=127.0.0.1:8080
GRAPHQL_POSTGRES_GENERATED_LOG=info,tower_http=debug
GRAPHQL_POSTGRES_GENERATED_LOG_FORMAT=pretty
GRAPHQL_POSTGRES_GENERATED_RATE_LIMIT_RPS=10
GRAPHQL_POSTGRES_GENERATED_RATE_LIMIT_BURST=50
GRAPHQL_POSTGRES_GENERATED_TRUST_PROXY=false
DATABASE_URL=postgres://postgres:postgres@localhost:5432/graphql_postgres_generated
GRAPHQL_POSTGRES_GENERATED_RUN_MIGRATIONS=true
