# Copy to .env; loaded at startup, existing variables are not overridden.
{{env_prefix}}_ADDR=127.0.0.1:8080
{{env_prefix}}_LOG=info,tower_http=debug
{{env_prefix}}_LOG_FORMAT=pretty
{{env_prefix}}_TEMPLATE_DIR=templates
{{env_prefix}}_TEMPLATE_RELOAD=true
{{env_prefix}}_STATIC_DIR=static
{{env_prefix}}_SESSION_TTL=86400
{{env_prefix}}_COOKIE_SECURE=false
{%- if store == "sqlite" %}
DATABASE_URL=sqlite://{{project-name}}.db?mode=rwc
{%- endif %}
{%- if store == "postgres" %}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{crate_name}}
{%- endif %}
{%- if sqlx %}
{{env_prefix}}_RUN_MIGRATIONS=true
{%- endif %}
{%- if auth != "none" %}
{{env_prefix}}_INVITE_TTL=604800
# Accepted as a registration token while no user exists; unset it afterwards.
#{{env_prefix}}_BOOTSTRAP_INVITE=change-me
{%- endif %}
{%- if auth == "google" %}
{{env_prefix}}_GOOGLE_CLIENT_ID=
{{env_prefix}}_GOOGLE_CLIENT_SECRET=
{{env_prefix}}_GOOGLE_REDIRECT_URL=http://127.0.0.1:8080/auth/google/callback
{%- endif %}
