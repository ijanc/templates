# Copy to .env; loaded at startup, existing variables are not overridden.
HEXAGONAL_GENERATED_ADDR=127.0.0.1:8080
HEXAGONAL_GENERATED_LOG=info,tower_http=debug
HEXAGONAL_GENERATED_LOG_FORMAT=pretty
HEXAGONAL_GENERATED_RATE_LIMIT_RPS=10
HEXAGONAL_GENERATED_RATE_LIMIT_BURST=50
HEXAGONAL_GENERATED_TRUST_PROXY=false
DATABASE_URL=sqlite://hexagonal-generated.db?mode=rwc
HEXAGONAL_GENERATED_RUN_MIGRATIONS=true
