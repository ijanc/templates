# Copy to .env; loaded at startup, existing variables are not overridden.
GRAPHQL_GENERATED_ADDR=127.0.0.1:8080
GRAPHQL_GENERATED_LOG=info,tower_http=debug
GRAPHQL_GENERATED_LOG_FORMAT=pretty
GRAPHQL_GENERATED_RATE_LIMIT_RPS=10
GRAPHQL_GENERATED_RATE_LIMIT_BURST=50
GRAPHQL_GENERATED_TRUST_PROXY=false
