# Copy to .env; loaded at startup, existing variables are not overridden.
WEB_GENERATED_ADDR=127.0.0.1:8080
WEB_GENERATED_LOG=info,tower_http=debug
WEB_GENERATED_LOG_FORMAT=pretty
WEB_GENERATED_TEMPLATE_DIR=templates
WEB_GENERATED_TEMPLATE_RELOAD=true
WEB_GENERATED_STATIC_DIR=static
WEB_GENERATED_SESSION_TTL=86400
WEB_GENERATED_COOKIE_SECURE=false
DATABASE_URL=sqlite://web-generated.db?mode=rwc
WEB_GENERATED_RUN_MIGRATIONS=true
WEB_GENERATED_INVITE_TTL=604800
# Accepted as a registration token while no user exists; unset it afterwards.
#WEB_GENERATED_BOOTSTRAP_INVITE=change-me
