{
  "lineWidth": 80,
  "markdown": {
    "textWrap": "always"
  },
  "exec": {
    "commands": [{ "command": "rustfmt --edition 2024", "exts": ["rs"] }]
  },
  "includes": ["**/*.md", "**/*.toml", "**/*.rs", "**/*.{yml,yaml}"],
  "excludes": ["target/**"],
  "plugins": [
    "npm:@dprint/markdown@0.24.0",
    "npm:@dprint/toml@0.8.0",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ]
}
