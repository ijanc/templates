# Copy to .env; loaded at startup, existing variables are not overridden.
GRAPHQL_SQLITE_GENERATED_ADDR=127.0.0.1:8080
GRAPHQL_SQLITE_GENERATED_LOG=info,tower_http=debug
GRAPHQL_SQLITE_GENERATED_LOG_FORMAT=pretty
GRAPHQL_SQLITE_GENERATED_RATE_LIMIT_RPS=10
GRAPHQL_SQLITE_GENERATED_RATE_LIMIT_BURST=50
GRAPHQL_SQLITE_GENERATED_TRUST_PROXY=false
DATABASE_URL=sqlite://graphql-sqlite-generated.db?mode=rwc
GRAPHQL_SQLITE_GENERATED_RUN_MIGRATIONS=true
GRAPHQL_SQLITE_GENERATED_CACHE_TTL=60
GRAPHQL_SQLITE_GENERATED_CACHE_CAPACITY=10000
