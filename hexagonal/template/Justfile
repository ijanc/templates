[private]
default:
    @just --list

alias ck := check

# Check formatting, spelling, licenses and layer dependencies
check:
    dprint check
    typos
    cargo deny check licenses
    sh contrib/arch.sh

# Fix formatting and spelling
fmt:
    dprint fmt
    typos --write-changes

# Fail when domain or application depend on an adapter concern
arch:
    sh contrib/arch.sh

# Build the release binaries
build:
    cargo build --release --workspace

# Run the server locally, reading .env
run:
    cargo run -p {{project-name}}

# Serve with bacon, rebuilding and restarting on change; systemfd holds
# ADDR open across restarts. Needs: cargo install bacon systemfd
dev ADDR="127.0.0.1:8080":
    systemfd --no-pid -s http::{% raw %}{{ADDR}}{% endraw %} -- bacon serve
{%- if cli %}

# Run the command line client, e.g. just cli items list
cli *ARGS:
    cargo run -q -p {{project-name}}-cli -- {% raw %}{{ARGS}}{% endraw %}
{%- endif %}

# Run every test in the workspace
test:
    cargo test --workspace

# Build the image for one platform and load it into the local daemon
docker-build PLATFORM="linux/amd64" TAG="{{project-name}}:latest":
    docker buildx build --platform {% raw %}{{PLATFORM}}{% endraw %} --load -t {% raw %}{{TAG}}{% endraw %} .

# Build amd64 and arm64 images and push them
docker-buildx TAG:
    docker buildx build --platform linux/amd64,linux/arm64 --push -t {% raw %}{{TAG}}{% endraw %} .

# Run the image built by docker-build
docker-run TAG="{{project-name}}:latest":
    docker run --rm -p 8080:8080 --env-file .env -e {{env_prefix}}_ADDR=0.0.0.0:8080 {% raw %}{{TAG}}{% endraw %}

# Start app{% if store == "postgres" %}, database{% endif %} and prometheus with docker compose
up:
    docker compose up --build --detach

# Stop and remove the compose services
down:
    docker compose down
{%- if sqlx %}

# Migrations need sqlx-cli: cargo install sqlx-cli --no-default-features --features {{store}}

# Create adapters/store-sqlx/migrations/<timestamp>_NAME.{up,down}.sql
migrate-add NAME:
    sqlx migrate add -r --source adapters/store-sqlx/migrations {% raw %}{{NAME}}{% endraw %}

# Apply pending migrations to DATABASE_URL
migrate-run:
    sqlx migrate run --source adapters/store-sqlx/migrations

# Revert the last migration
migrate-revert:
    sqlx migrate revert --source adapters/store-sqlx/migrations

# Drop, recreate and migrate the database
db-reset:
    sqlx database reset -y --source adapters/store-sqlx/migrations
{%- endif %}

# Print the OpenAPI document of a running server
openapi ADDR="127.0.0.1:8080":
    curl -fsS http://{% raw %}{{ADDR}}{% endraw %}/api-docs/openapi.json

# Generate the security PGP key and record it in SECURITY.md
security-key:
    sh contrib/gen-security-key.sh
